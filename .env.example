# Copy to .env locally — never commit .env. Set the same keys in your host (Streamlit Cloud, etc.).

# U.S. Energy Information Administration — https://www.eia.gov/opendata/
EIA_API_KEY=

# Federal Reserve Economic Data — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional override (default in code: gpt-4.1-nano)
OPENAI_MODEL=gpt-5-mini
